# Music OS -> FACKTS Africa CRM (server-side only)
# Set in the Music OS Vercel project, Production environment.
# Set FACKTS_CRM_WEBHOOK_SECRET to the EXACT SAME private value as
# CRM_INTEGRATION_SECRET_MUSIC on the FACKTS Africa OS Vercel project.
# Never use NEXT_PUBLIC_ for this secret or commit an actual secret.
FACKTS_CRM_URL=https://backoffice.facktsafrica.co.ke
FACKTS_CRM_WEBHOOK_SECRET=

# Optional AI navigation answers. Disabled unless explicitly enabled.
FACKTS_AI_HELPER_ENABLED=false
OPENAI_API_KEY=
OPENAI_HELPER_MODEL=

# Local Phase 2 inspection: use NEXT_PUBLIC_SITE_URL=http://localhost:3000.
# Keep real values in .env.local, which is ignored by git. Never expose server keys with NEXT_PUBLIC_.

# Core application (use an authorised test/staging backend for local writes).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY
# Required for real uploads and private media; leave blank when not configured.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=
